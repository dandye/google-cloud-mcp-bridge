# ==============================================================================
# Environment Configuration for google-cloud-mcp-bridge
# ==============================================================================

# Application Settings
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Google Cloud Platform Settings
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true
ADK_DISABLE_JSON_SCHEMA_FOR_FUNC_DECL=true

# Active Remote MCP Service Configuration
# Supported catalog options: recommender, compute, bigquery, cloudbilling, run, storage, secops
ACTIVE_MCP_SERVICE=recommender
# MCP_SERVER_URL=https://recommender.googleapis.com/mcp
MODEL_NAME=gemini-2.5-flash

# Server Configuration (PORT is reserved by Agent Runtime; defaults to 8080)
HOST=0.0.0.0
# PORT=8080

# Gemini Enterprise Publishing (Optional, for deploy.sh)
# GEMINI_ENTERPRISE_APP_ID=projects/PROJECT_NUMBER/locations/global/collections/default_collection/engines/APP_ID

# Direct Gemini API Key (Optional, if Vertex AI is not used)
# GEMINI_API_KEY=
